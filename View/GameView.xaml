<UserControl x:Class="Chess.View.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chess.View"
             xmlns:controls="clr-namespace:Chess.View"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="833">
    <UserControl.Resources>
        <!-- BLUE BUTTON STYLE -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#49c3d8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37a1b9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#49c3d8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GRAY BUTTON STYLE -->
        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla paneli Forfeit i Timeout -->
        <Style x:Key="GameOverPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#252525">
        <ContentControl x:Name="CC" Margin="442,0,10,57"/>
        <controls:BoardWindow x:Name="Board" Margin="56,34,377,57"/>
        <Button x:Name="play_forfeit" FontWeight="Bold" FontSize="30" Foreground="White" Content="Play" 
                Style="{StaticResource BlueButtonStyle}" HorizontalAlignment="Left" Margin="529,416,0,0" 
                VerticalAlignment="Top" Height="58" Width="218" Click="play_forfeit_Click"/>
        <Button x:Name="NerdViewButton" Content="Nerd View" Style="{StaticResource BlueButtonStyle}" 
                FontSize="16" Height="28" Width="104" 
                HorizontalAlignment="Left" Margin="36,465,0,0" VerticalAlignment="Top" 
                Click="NerdViewButton_Click"/>
        <Border Background="#333" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="181,462,0,0" Padding="10, 4" Width="150" Height="40">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="WHITE:" FontSize="11" Foreground="White" FontWeight="Bold" Height="16" Width="43"/>
                <Border BorderBrush="#49c3d8" BorderThickness="2" CornerRadius="8" Padding="10,2" Height="28">
                    <TextBlock Text="00:00:00" FontSize="14" x:Name="WhiteTimerText" Foreground="White" 
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
        <local:GameSidePanelPlayingView x:Name="NotationPanel" Margin="-24,0,0,0"/>
        <Border Background="#333" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="181,10,0,0" Padding="10, 4" Width="150" Height="38">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="BLACK:" FontSize="11" Foreground="White" FontWeight="Bold" Height="16" Width="43"/>
                <Border BorderBrush="#49c3d8" BorderThickness="2" CornerRadius="8" Padding="10,2" Height="28">
                    <TextBlock Text="00:00:00" FontSize="14" x:Name="BlackTimerText" Foreground="White" 
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
        <Button Style="{StaticResource GrayButtonStyle}" 
                x:Name="Home" HorizontalAlignment="Left" Margin="13,5,0,0" VerticalAlignment="Top" 
                Height="43" Width="45" Background="#444" Command="{Binding NavigateToHomeViewCommand}">
            <Button.Content>
                <Label Content="←" FontSize="60" Margin="0,-30,5,0" FontWeight="UltraBold" Foreground="White"/>
            </Button.Content>
        </Button>
        <Border x:Name="ForfeitPanel" Style="{StaticResource GameOverPanelStyle}" 
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="150">
            <StackPanel>
                <Label Content="Forfeit" Foreground="White" FontSize="30" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
                <Button x:Name="ForfeitBackToMenu" Style="{StaticResource GrayButtonStyle}" 
                        Width="140" Height="27" Click="ForfeitBackToMenu_Click">
                    <Label Content="Back To Menu" FontSize="12" FontWeight="UltraBold" 
                           Foreground="White" Height="41"/>
                </Button>
            </StackPanel>
        </Border>
        <Border x:Name="TimeoutPanel" Style="{StaticResource GameOverPanelStyle}" 
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="150">
            <StackPanel>
                <TextBlock x:Name="TimeoutLabel" Foreground="White" FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                <Button x:Name="TimeoutBackToMenu" Style="{StaticResource GrayButtonStyle}" 
                        Width="140" Height="27" Click="TimeoutBackToMenu_Click">
                    <Label Content="Back To Menu" FontSize="12" FontWeight="UltraBold" 
                           Foreground="White" Height="41"/>
                </Button>
            </StackPanel>
        </Border>
        <Border x:Name="NerdViewPanel" Style="{StaticResource GameOverPanelStyle}" 
        HorizontalAlignment="Center" VerticalAlignment="Center" Width="350" Height="225">
            <StackPanel>
                <Label Content="Nerd View" Foreground="White" FontSize="30" FontWeight="Bold" 
               HorizontalAlignment="Center"/>
                <TextBlock x:Name="NerdInfoLabel" Foreground="White" FontSize="12" FontWeight="Bold" 
                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="310"/>
                <Button x:Name="NerdViewOKButton" Style="{StaticResource GrayButtonStyle}" 
                Width="140" Height="27" Click="NerdViewOKButton_Click" Margin="0,10,0,0">
                    <Label Content="OK" FontSize="12" FontWeight="UltraBold" Foreground="White" Height="41"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>