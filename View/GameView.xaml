<UserControl x:Class="Chess.View.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chess.View"
             xmlns:controls="clr-namespace:Chess.View"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="833">
    <UserControl.Resources>
        <!-- BLUE BUTTON STYLE -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#49c3d8"/>
            <!-- Light Blue -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover Effect for Blue Button -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37a1b9"/>
                                <!-- Darker Blue -->
                            </Trigger>

                            <!-- Click Effect for Blue Button -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#49c3d8"/>
                                <!-- Even Darker Blue -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GRAY BUTTON STYLE -->
        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#444"/>
            <!-- Dark Gray -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover Effect for Gray Button -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333"/>
                                <!-- Medium Gray -->
                            </Trigger>

                            <!-- Click Effect for Gray Button -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444"/>
                                <!-- Darkest Gray -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="#252525">
        <ContentControl x:Name="CC" Margin="529,0,10,57"/>
        <controls:BoardWindow x:Name="Board" Margin="56,34,377,57"/>
        <Button x:Name="play_forfeit" FontWeight="Bold" FontSize="30" Foreground="White" Content="Play" Style="{StaticResource BlueButtonStyle}" HorizontalAlignment="Left" Margin="529,416,0,0" VerticalAlignment="Top" Height="58" Width="218" Click="play_forfeit_Click"/>
        <Border Background="#333" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="181,462,0,0" Padding="10, 4" Width="150" Height="40">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="WHITE:" FontSize="11" Foreground="White" FontWeight="Bold" Height="16" Width="43"/>
                <Border BorderBrush="#49c3d8" BorderThickness="2" CornerRadius="8" Padding="10,2" Height="28">
                    <TextBlock Text="00:00:00" FontSize="14" x:Name="WhiteTimerText" Foreground="White" 
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
        <Border Background="#333" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" 
        Margin="181,10,0,0" Padding="10, 4" Width="150" Height="38">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="BLACK:" FontSize="11" Foreground="White" FontWeight="Bold" Height="16" Width="43"/>
                <Border BorderBrush="#49c3d8" BorderThickness="2" CornerRadius="8" Padding="10,2" Height="28">
                    <TextBlock Text="00:00:00" FontSize="14" x:Name="BlackTimerText" Foreground="White" 
                       FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
        <Button Style="{StaticResource GrayButtonStyle}" 
     HorizontalAlignment="Left"
     Margin="13,5,0,0" 
     VerticalAlignment="Top" 
     Height="43" 
     Width="45"
     Background="#444"
     Command="{Binding  NavigateToHomeViewCommand}">
            <Button.Content>
                <Label Content="←"
            FontSize="60"
            Margin="0,-30,5,0"
            FontWeight="UltraBold"
            Foreground="White"/>
            </Button.Content>
        </Button>
    </Grid>
</UserControl>
