<UserControl x:Class="Chess.View.MultiPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chess.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="833"
             Background="#252525">
    <UserControl.Resources>
        <!-- BLUE BUTTON STYLE -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#49c3d8"/>
            <!-- Light Blue -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover Effect for Blue Button -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37a1b9"/>
                                <!-- Darker Blue -->
                            </Trigger>

                            <!-- Click Effect for Blue Button -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#49c3d8"/>
                                <!-- Even Darker Blue -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GRAY BUTTON STYLE -->
        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#444"/>
            <!-- Dark Gray -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover Effect for Gray Button -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333"/>
                                <!-- Medium Gray -->
                            </Trigger>

                            <!-- Click Effect for Gray Button -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444"/>
                                <!-- Darkest Gray -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Przycisk PvPBtn -->
        <Button x:Name="PvPBtn" 
                Content="Player vs Player"
                Style="{StaticResource BlueButtonStyle}"
                FontWeight="Bold" 
                FontSize="30" 
                Foreground="White" 
                Background="#49c3d8"
                HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,100,0,0" 
                Height="85" 
                Width="300"/>

        <Button x:Name="PvPLANBtn" 
                Content="Player vs Online Player"
                Style="{StaticResource GrayButtonStyle}"
                FontWeight="Bold" 
                FontSize="22" 
                Foreground="White" 
                Background="#444"
                HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,200,0,0" 
                Height="85" 
                Width="300"/>

        <Button x:Name="Home" Style="{StaticResource GrayButtonStyle}" 
                HorizontalAlignment="Left"
                Margin="14,14,0,0" 
                VerticalAlignment="Top" 
                Height="48" 
                Width="50"
                Background="#444">
            <Button.Content>
                <Label Content="←"
                       FontSize="60"
                       Margin="0,-28,5,0"
                       FontWeight="UltraBold"
                       Foreground="White"/>
            </Button.Content>
        </Button>
    </Grid>
</UserControl>