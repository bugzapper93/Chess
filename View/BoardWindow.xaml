<UserControl x:Class="Chess.View.BoardWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chess.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#49c3d8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37a1b9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#49c3d8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameOverPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Canvas x:Name="display"/>
        <Border x:Name="CheckmatePanel" Style="{StaticResource GameOverPanelStyle}" 
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="150">
            <StackPanel>
                <Label Content="Checkmate" Foreground="White" FontSize="30" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
                <Button x:Name="CheckmateBackToMenu" Style="{StaticResource GrayButtonStyle}" Width="140" Height="27">
                    <Label Content="Back To Menu" FontSize="12" FontWeight="UltraBold" 
                       Foreground="White" Height="41"/>
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="StalematePanel" Style="{StaticResource GameOverPanelStyle}" 
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="150">
            <StackPanel>
                <Label Content="Stalemate" Foreground="White" FontSize="30" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
                <Button x:Name="StalemateBackToMenu" Style="{StaticResource GrayButtonStyle}" Width="140" Height="27">
                    <Label Content="Back To Menu" FontSize="12" FontWeight="UltraBold" 
                               Foreground="White" Height="41"/>
                </Button>
            </StackPanel>
        </Border>
        <Border x:Name="PromotionPanel" Style="{StaticResource GameOverPanelStyle}" 
        HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="250">
            <StackPanel>
                <Label Content="Choose type of figure" Foreground="White" FontSize="15" FontWeight="Bold" 
               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <Grid Width="140" Height="140">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PromoteToQueenButton" Grid.Row="0" Grid.Column="0" 
                    Width="50" Height="50" Margin="5" Click="PromoteToQueenButton_Click">
                        <Image Source="/Resources/Images/queen_black.png" Stretch="Fill"/>
                    </Button>

                    <Button x:Name="PromoteToRookButton" Grid.Row="0" Grid.Column="1" 
                    Width="50" Height="50" Margin="5" Click="PromoteToRookButton_Click">
                        <Image Source="/Resources/Images/rook_white.png" Stretch="Fill"/>
                    </Button>

                    <Button x:Name="PromoteToBishopButton" Grid.Row="1" Grid.Column="0" 
                    Width="50" Height="50" Margin="5" Click="PromoteToBishopButton_Click">
                        <Image Source="/Resources/Images/bishop_black.png" Stretch="Fill"/>
                    </Button>

                    <Button x:Name="PromoteToKnightButton" Grid.Row="1" Grid.Column="1" 
                    Width="50" Height="50" Margin="5" Click="PromoteToKnightButton_Click">
                        <Image Source="/Resources/Images/knight_white.png" Stretch="Fill" Width="30" Height="30"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

