<UserControl x:Class="Chess.View.MpPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chess.View"
             mc:Ignorable="d" d:DesignWidth="833"
             Background="#252525" Height="512">
    <UserControl.Resources>
        <!-- BLUE BUTTON STYLE -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#49c3d8"/>
            <!-- Light Blue -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover Effect for Blue Button -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37a1b9"/>
                                <!-- Darker Blue -->
                            </Trigger>

                            <!-- Click Effect for Blue Button -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#49c3d8"/>
                                <!-- Even Darker Blue -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GRAY BUTTON STYLE -->
        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#444"/>
            <!-- Dark Gray -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover Effect for Gray Button -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333"/>
                                <!-- Medium Gray -->
                            </Trigger>

                            <!-- Click Effect for Gray Button -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444"/>
                                <!-- Darkest Gray -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1ca530"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#188929"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1ca530 "/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>




        <Style x:Key="OrangeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#dd8a1c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#c97d1a"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#dd8a1c   "/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,0,0,425">
        <Button Style="{StaticResource GrayButtonStyle}" 
    x:Name="Home"
    HorizontalAlignment="Left"
    Margin="14,14,0,0" 
    VerticalAlignment="Top" 
    Height="48" 
    Width="50"
    Background="#444"
    Command="{Binding  NavigateToHomeViewCommand}">
            <Button.Content>
                <Label Content="←"
           FontSize="60"
           Margin="0,-28,5,0"
           FontWeight="UltraBold"
           Foreground="White"/>
            </Button.Content>
        </Button>

        <Canvas Background="#1e1e1e " Margin="78,14,15,388">
            <Label FontSize="25" Foreground="White" FontWeight="Bold" Content="Nick:" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="2"/>
            <TextBox x:Name="txtNick" 
         BorderThickness="0" 
         FontSize="15" 
         Foreground="White" 
         TextAlignment="Center" 
         VerticalContentAlignment="Center" 
         Background="#444" 
         HorizontalAlignment="Left" 
         TextWrapping="Wrap" 
         Text="Enter your nick..." 
         VerticalAlignment="Top" 
         Width="204" 
         Height="36" 
         Canvas.Left="76" 
         Canvas.Top="6"
         GotFocus="TxtNick_GotFocus" 
         LostFocus="TxtNick_LostFocus"/>
            <Button x:Name="btnHost" Style="{StaticResource BlueButtonStyle}" Content="Host Lobby" FontSize="20  " HorizontalAlignment="Left" VerticalAlignment="Top" Height="36" Width="134" Canvas.Left="294" Canvas.Top="6" Click="btnHost_Click"/>
            <Button x:Name="btnJoin" Style="{StaticResource GreenButtonStyle}" Content="Join Lobby" FontSize="20  " HorizontalAlignment="Left" VerticalAlignment="Top" Height="36" Width="134" Canvas.Left="444" Canvas.Top="6" Click="btnJoin_Click"/>
            <Button x:Name="btnLeave" Style="{StaticResource GrayButtonStyle}" Content="Leave Lobby" FontSize="20  " HorizontalAlignment="Left" VerticalAlignment="Top" Height="36" Width="134" Canvas.Left="592" Canvas.Top="6" Click="btnLeave_Click"/>
        </Canvas>
        <Canvas Background="#1e1e1e " Margin="14,79,628,16">
            <Label FontSize="20" Foreground="White" FontWeight="Bold" Content="Player list (     ):" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Left="5"/>
            <Label FontSize="20" Foreground="#49c3d8" HorizontalContentAlignment="Center" FontWeight="Bold" Content="0" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.Left="101" Width="56" Canvas.Top="1"/>
            <GroupBox x:Name="playersGroupBox" Grid.Row="1" Grid.Column="2" VerticalAlignment="Top"
          Foreground="White" FontSize="20" FontWeight="Bold" Background="#1e1e1e" BorderBrush="#444" HorizontalAlignment="Center" Canvas.Top="43" Width="191" Height="303">
                <ListBox x:Name="lstGracze" Height="290" FontSize="12" 
             Background="#444" Foreground="White" BorderThickness="0"
             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="2">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#555"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#666"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </GroupBox>
        </Canvas>

        <Canvas Background="#1e1e1e " Margin="602,79,15,16">
            <Label FontSize="20" Foreground="White" FontWeight="Bold" Content="Chat:" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="3" Canvas.Left="4"/>
            <ScrollViewer Height="255" VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#252525" HorizontalAlignment="Center" VerticalAlignment="Center" Width="216" Canvas.Top="40">
                <ListBox x:Name="lstChatMessages" FontSize="12" 
                    Background="#444" Foreground="White"
                    BorderThickness="0" Height="245" Width="206">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="#252525"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border Background="{TemplateBinding Background}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="2">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#333"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#444"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </ScrollViewer>

            <Button x:Name="btnSendMessage" Style="{StaticResource GrayButtonStyle}" Content="Send" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Center" Height="36" Width="52" Canvas.Left="154" Canvas.Top="309" Click="btnSendMessage_Click"/>
            <TextBox x:Name="txtChatInput" BorderThickness="0" FontSize="10" Foreground="White" TextAlignment="Left" VerticalContentAlignment="Center" Background="#444" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" Width="139" Height="36" Canvas.Left="10" Canvas.Top="309" KeyDown="txtChatInput_KeyDown"/>
        </Canvas>
        <Canvas Background="#1e1e1e " Margin="224,79,250,77">
            <Label FontSize="20" Foreground="White" FontWeight="Bold" Content="Available hosts:" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="3" Canvas.Left="5"/>
            <Button x:Name="btnRefresh" Style="{StaticResource OrangeButtonStyle}" Content="Refresh" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Center" Height="26" Width="103" Canvas.Left="246" Canvas.Top="6" RenderTransformOrigin="0.5,0.5" Click="btnRefresh_Click">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="0.655"/>
                        <RotateTransform/>
                        <TranslateTransform X="0.189"/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <ListView x:Name="lvwHosts" Height="245" Width="344" HorizontalAlignment="Left" FontSize="12"
          Background="#444" Foreground="White" BorderThickness="0"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" Canvas.Top="45" Canvas.Left="5">
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}">
                        <Setter Property="Background" Value="#444"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                    <Grid>
                                        <Border Background="{TemplateBinding Background}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Background" Value="#444"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                                        <GridViewRowPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#555"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#666"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>
                <ListView.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="0"/>
                        <RotateTransform/>
                        <TranslateTransform X="0"/>
                    </TransformGroup>
                </ListView.RenderTransform>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Host Name" 
                          Width="170"
                          DisplayMemberBinding="{Binding Path=Nickname}"/>
                        <GridViewColumn Header="IP Address" 
                          Width="170"
                          DisplayMemberBinding="{Binding Path=IP}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Canvas>

        <Canvas Background="#1e1e1e " Margin="224,385,250,16">
            <Button x:Name="btnStartGame" Style="{StaticResource BlueButtonStyle}" Command="{Binding NavigateToGameViewCommand}" Content="Start Game" FontSize="20  " HorizontalAlignment="Center" VerticalAlignment="Top" Height="54" Width="185" Canvas.Left="12" Click="btnStartGame_Click" Canvas.Top="-5"/>
            <Button x:Name="white" Style="{StaticResource GrayButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="54" Width="55" Canvas.Left="216" Canvas.Top="-5">
                <Image x:Name="whiteImg" Width="40" Height="40"/>
            </Button>
            <Button x:Name="black" Style="{StaticResource BlueButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="54" Width="55" Canvas.Left="284" Canvas.Top="-5">
                <Image x:Name="blackImg" Width="40" Height="40"/>
            </Button>
        </Canvas>
        <StatusBar Background="#252525" Foreground="White" 
           FontFamily="Consolas" FontSize="7" Padding="8,5" BorderThickness="0" Margin="1,435,-1,-425">
            <StatusBar.Resources>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="#444"/>
                    <Setter Property="Margin" Value="10,0"/>
                    <Setter Property="Width" Value="1"/>
                </Style>
            </StatusBar.Resources>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Label Content="●" Foreground="#49c3d8" FontWeight="Bold" 
                   VerticalAlignment="Center" Padding="0,0,5,0"/>
                    <TextBlock x:Name="toolStripStatusLabel1" Text="Status: Disconnected" 
                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Label Content="●" Foreground="#dd8a1c" FontWeight="Bold" 
                   VerticalAlignment="Center" Padding="0,0,5,0"/>
                    <TextBlock x:Name="toolStripStatusLabelIP" Text="Local IP: " 
                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>